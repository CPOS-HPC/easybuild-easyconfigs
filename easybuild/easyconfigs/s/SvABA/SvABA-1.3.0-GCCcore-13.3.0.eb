# John Dey Fred Hutch
# Original: https://github.com/FredHutch/easybuild-life-sciences/blob/main/easyconfigs/s/svaba/svaba-1.3.0-GCCcore-13.3.0.eb
# Updated by Emik Lin (HKUMed CPOS)
easyblock = 'CMakeMakeCp'

name = 'SvABA'
version = '1.3.0'
local_commit = '4edce7e'

homepage = 'https://github.com/walaj/svaba'
description = """SvABA - Structural variation and indel analysis by assembly"""

toolchain = {'name': 'GCC', 'version': '13.3.0'}

# create tar ball from recursive clone of repository
# git clone --recursive https://github.com/walaj/svaba
source_urls = 'https://github.com/walaj/svaba/archive/',
sources = [{'download_filename': '%s.tar.gz' % local_commit, 'filename': SOURCE_TAR_GZ}]
checksums = [
    '719b8a3579bee8d9e492d3782c3cd96210808667218b8bffbcd0e3281ca3a7ff', # SvABA-1.3.0.tar.gz
    'fda301172c0026393205054be848768db55ed54e7bbc521eace8bf397ae80319', # SvABA-1.3.0_use-external-deps.patch
]

builddependencies = [
    ('CMake', '3.29.3'),
    ('binutils', '2.42'),
]

dependencies = [
    ('HTSlib', '1.21'),
    ('XZ', '5.4.5'),
    ('bzip2', '1.0.8'),
    ('SeqLib', '1.2.0'),
]

separate_build_dir = True

configopts = "-DHTSLIB_DIR=$EBROOTHTSLIB/lib "

files_to_copy = [
    (['%(namelower)s'], 'bin'),
    (['SeqLib/libseqlib.a'], 'lib'),
    (['%(builddir)s/%(namelower)s/R'], ''),
]

modextrapaths = {'R_LIBS_SITE': 'R'}

sanity_check_commands = ['%(namelower)s --version']

sanity_check_paths = {
    'files': ['bin/%(namelower)s', 'R/%(namelower)s-annotate.R'],
    'dirs': [],
}

moduleclass = 'bio'