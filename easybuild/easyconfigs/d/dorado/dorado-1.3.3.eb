# Use binary distribution to avoid building Dorado and its bundled dependencies from source

easyblock = 'Tarball'

name = 'dorado'
version = '1.3.3'

homepage = 'https://github.com/nanoporetech/dorado'
description = "Dorado is a high-performance, easy-to-use, open source basecaller for Oxford Nanopore reads."

toolchain = SYSTEM

source_urls = ['https://cdn.oxfordnanoportal.com/software/analysis/']
sources = ['%(name)s-%(version)s-linux-x64.tar.gz']
checksums = ['6f41582b66026d5f5143dd5f3c0f21ebace55b7f108a9d64e8e9ff2f8d1a1018']

postinstallcmds = [
    "mkdir %(installdir)s/models && cd %(installdir)s/models && "
    "%(installdir)s/bin/%(name)s download --model all",
]

modextravars = {'DORADO_MODELS_DIRECTORY': '%(installdir)s/models'}

sanity_check_paths = {
    'files': ['bin/%(name)s'],
    'dirs': [],
}

sanity_check_commands = ["%(name)s basecaller --help"]

moduleclass = 'bio'
