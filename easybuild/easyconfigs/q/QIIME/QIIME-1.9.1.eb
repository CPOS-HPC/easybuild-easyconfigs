# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild
# Author: Pablo Escobar Lopez
# sciCORE - University of Basel
# SIB Swiss Institute of Bioinformatics 

easyblock = 'Conda'

name = 'QIIME'
version = '1.9.1'

homepage = 'https://qiime.org/'
description = """QIIME is an open-source bioinformatics pipeline for performing microbiome analysis
 from raw DNA sequencing data."""

toolchain = SYSTEM

requirements = "%(namelower)s=%(version)s python=2.7 matplotlib=1.5.3 mock nose"
channels = ['bioconda', 'conda-forge']

builddependencies = [('Miniconda3', '25.7.0-2')]

sanity_check_paths = {
    'files': ['bin/print_qiime_config.py'],
    'dirs': ['lib'],
}

sanity_check_commands = ['print_qiime_config.py -t']

modextrapaths = {'PYTHONPATH': 'site-packages'}

moduleclass = 'bio'
