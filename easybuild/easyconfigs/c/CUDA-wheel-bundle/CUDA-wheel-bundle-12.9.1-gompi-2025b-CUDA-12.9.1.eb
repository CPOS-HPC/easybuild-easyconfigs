easyblock = 'PythonBundle'

name = 'CUDA-wheel-bundle'
version = '12.9.1'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://developer.nvidia.com/cuda'
description = "Repackaging of NVIDIA CUDA libraries as Python packages"

toolchain = {'name': 'gompi', 'version': '2025b'}

dependencies = [
    ('CUDA', version, '', SYSTEM),
    ('cuDNN', '9.20.0.48', versionsuffix, SYSTEM),
    ('cuSPARSELt', '0.8.1.1', versionsuffix, SYSTEM),
    ('NCCL', '2.29.7', versionsuffix),
    ('NVSHMEM', '3.4.5', versionsuffix),
    ('Python', '3.13.5'),
]

exts_default_options = {
    'modulename': False,  # CUDA runtime metadata packages have no Python import.
}

local_cuda_component = {'dummy_package': True, 'nosource': True}

exts_list = [
    # CUDA 12.9.1 already provides these components at the versions required by cuda-toolkit.
    ('nvidia-cublas-cu12', '12.9.1.4', local_cuda_component),
    ('nvidia-cuda-cupti-cu12', '12.9.79', local_cuda_component),
    ('nvidia-cuda-nvrtc-cu12', '12.9.86', local_cuda_component),
    ('nvidia-cuda-runtime-cu12', '12.9.79', local_cuda_component),
    ('nvidia-cufft-cu12', '11.4.1.4', local_cuda_component),
    ('nvidia-cufile-cu12', '1.14.1.1', local_cuda_component),
    ('nvidia-curand-cu12', '10.3.10.19', local_cuda_component),
    ('nvidia-cusolver-cu12', '11.7.5.82', local_cuda_component),
    ('nvidia-cusparse-cu12', '12.5.10.65', local_cuda_component),
    ('nvidia-nvjitlink-cu12', '12.9.86', local_cuda_component),
    ('nvidia-nvtx-cu12', '12.9.79', local_cuda_component),
    # Provided by the matching CUDA library modules above.
    ('nvidia-cudnn-cu12', '9.20.0.48', local_cuda_component),
    ('nvidia-cusparselt-cu12', '0.8.1', local_cuda_component),
    ('nvidia-nccl-cu12', '2.29.7', local_cuda_component),
    ('nvidia-nvshmem-cu12', '3.4.5', local_cuda_component),
    ('cuda-toolkit', version, {
        'sources': ['cuda_toolkit-%(version)s-py2.py3-none-any.whl'],
        'checksums': ['0c8636dfacbecfe9867a949a211864f080a805bc54023ce4a361aa4e1fd8738b'],
    }),
    ('cuda-pathfinder', '1.8.6', {
        'modulename': 'cuda.pathfinder',
        'sources': ['cuda_pathfinder-%(version)s-py3-none-any.whl'],
        'checksums': ['bf6b3b06323cf95a11d671818392da5da23ddbbb4dfc4b77ca10622783c25980'],
    }),
    ('cuda-bindings', '12.9.10', {
        'modulename': 'cuda.bindings',
        'sources': [f'cuda_bindings-%(version)s-cp313-cp313-manylinux_2_24_{ARCH}.manylinux_2_28_{ARCH}.whl'],
        'checksums': [{
            'cuda_bindings-12.9.10-cp313-cp313-manylinux_2_24_aarch64.manylinux_2_28_aarch64.whl':
                'ddc659577e2aa27f1785eb5c7cf68f03e8d5036221f2da910a4ea0cfa7d677b4',
            'cuda_bindings-12.9.10-cp313-cp313-manylinux_2_24_x86_64.manylinux_2_28_x86_64.whl':
                '761589eb7fdc585d8bc496bff6185c8828c1b1e151e3769ac05824512e883dbd',
        }],
    }),
]

moduleclass = 'lib'
