easyblock = 'PythonBundle'

name = 'CIRCexplorer2'
version = '2.3.8'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://circexplorer2.readthedocs.io/'
description = "CIRCexplorer2 is a comprehensive and integrative circular RNA analysis toolset."

toolchain = {'name': 'foss', 'version': '2023a'}

dependencies = [
    ('Python', '2.7.18'),
    ('SciPy-bundle', '2024.06', versionsuffix),
    ('TopHat', '2.1.2', versionsuffix),
    ('Cufflinks', '20190706'),
    ('BEDTools', '2.31.0'),
    ('Kent_tools', '468'),
    ('Bowtie', '1.3.1'),
    ('Bowtie2', '2.5.4', versionsuffix),
    ('STAR', '2.7.11b'),
    ('BWA', '0.7.18'),
    ('Pysam', '0.20.0', versionsuffix),
    ('pybedtools', '0.8.2', versionsuffix),
]

exts_list = [
    ('docopt', '0.6.2', {
        'checksums': ['49b3a825280bd66b3aa83585ef59c4a8c82f2c8a522dbe754a8bc8d08c85c491'],
    }),
    (name, version, {
        'modulename': 'circ2',
        'checksums': ['8261ee884f6d895131ce681d5eda6554376e973851a9de4dc50e2b3e242ccc80'],
    }),
]

sanity_check_paths = {
    'files': ['bin/CIRCexplorer2'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ['CIRCexplorer2 denovo --help']

moduleclass = 'bio'
