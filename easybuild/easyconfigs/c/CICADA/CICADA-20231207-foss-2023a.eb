easyblock = 'Tarball'

name = 'CICADA'
version = '20231207'
local_commit = '982900e68a2bf9caf48777bcb7129e313e19ce83'

homepage = 'https://github.com/SunLab-biotool/CICADA'
description = (
    "CICADA (circRNA coding capability and product detection algorithm) software is a powerful tool designed to "
    "accurately distinguish the coding potential and products of circular RNAs (circRNAs)"
)

toolchain = {'name': 'foss', 'version': '2023a'}

source_urls = ['https://github.com/SunLab-biotool/CICADA/archive/']
sources = [{'download_filename': '%s.tar.gz' % local_commit, 'filename': SOURCE_TAR_GZ}]
patches = ['%(name)s-%(version)s-fix-helper-paths.patch']
checksums = [
    {'CICADA-20231207.tar.gz': 'c9730f0ca4b32aa6813c6b2632d06a586d8ef12284064a11acbf29d6249bc152'},
    {'CICADA-20231207-fix-helper-paths.patch': '69d925d75c178af0178cf3361988029d6069597ca74ad2f2d00696694723f2fb'},
]

dependencies = [
    ('Python', '3.11.3'),
    ('Python-bundle-PyPI', '2023.06'),  # joblib
    ('SciPy-bundle', '2023.07'),  # pandas
    ('scikit-learn', '1.1.3'),  # serialized random forest model
    ('PhyloCSF', '20231016'),
    ('rpy2', '3.5.15'),
    ('LncFinder', '1.1.6', '-R-4.3.2'),
    ('Perl', '5.36.1'),  # auxiliary runsramp.pl script
]

postinstallcmds = [
    "sed -i '1i#!/usr/bin/env python3' %(installdir)s/CICADA.py",
    'chmod a+x %(installdir)s/CICADA.py',
]

modextrapaths = {'PATH': ['']}

sanity_check_paths = {
    'files': ['CICADA.py', 'CICADA_Parameters/circRNA_Score_Matrix'],
    'dirs': ['models', 'example'],
}

sanity_check_commands = ['CICADA.py --help']

moduleclass = 'bio'
