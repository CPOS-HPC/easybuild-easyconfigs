easyblock = 'PythonPackage'

name = 'REDItools'
version = '1.3'
versionsuffix = '-Python-%(pyver)s'
local_commit = '68880de6bda9b0a892a4d8c7fcb08bd641c51dc2'

homepage = 'https://github.com/BioinfoUNIBA/REDItools'
description = "REDItools: python scripts for RNA editing detection by RNA-Seq data"

toolchain = {'name': 'GCC', 'version': '12.3.0'}

source_urls = ['https://github.com/BioinfoUNIBA/REDItools/archive/']
sources = [{'download_filename': '%s.tar.gz' % local_commit, 'filename': SOURCE_TAR_GZ}]
checksums = ['c56e024c113e6a6af0cec0493adbafc26388aebb2723d000df05b0b8ad9170f5']

dependencies = [
    ('Python', '2.7.18'),
    ('Pysam', '0.20.0', versionsuffix),
]

options = {'modulename': False}

fix_python_shebang_for = ['bin/*.py']

sanity_check_commands = ['REDItoolDnaRna.py --help']

moduleclass = 'bio'
