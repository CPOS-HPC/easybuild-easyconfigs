dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-bundle', '2024.05'),
    ('R', '4.4.2'),
    ('R-bundle-CRAN', '2024.11'),
    ('IPython', '8.28.0'),
    ('cffi', '1.16.0'),
]

