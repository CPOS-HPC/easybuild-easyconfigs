Fix `project.license` validation error in `pyproject.toml` on Python 3.13+ (strict PEP 621).
Updates the license field from a string to the required table format: `license = {text = "..."}`.
Author: Emik Lin (HKUMed CPOS)
--- pyproject.toml.orig	2025-09-24 09:01:48.000000000 +0800
+++ pyproject.toml	2026-01-22 10:31:22.832173273 +0800
@@ -13,7 +13,7 @@
 description = "Python interface to the R language (embedded R)"
 readme = "README.md"
 requires-python = ">=3.8"
-license = "GPL-2.0-or-later"
+license = {text = "GPL-2.0-or-later"}
 license-files = ["LICENSE"]
 authors = [{ name = "Laurent Gautier", email = "lgautier@gmail.com" }]
 classifiers = [
