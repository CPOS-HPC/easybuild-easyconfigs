easyblock = 'PythonPackage'

name = 'rapidgzip'
version = '0.16.0'

homepage = 'https://github.com/mxmlnkn/rapidgzip'
description = "Parallelized Decompression of Gzip Files with Support for Fast Random Access."

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['8b124f29bc12de4249ab81e83e5ad35e67742a1a8ff4acb61b74c0d9fda1c14e']

builddependencies = [
    ('binutils', '2.40'),
    ('Cython', '3.0.10'),
    ('NASM', '2.16.01'),
]
dependencies = [('Python', '3.11.3')]

sanity_check_commands = ['%(name)s --version']

moduleclass = 'tools'
