sources += [{
    'filename': '%s.%s.nupkg' % (pkg, ver),
    'source_urls': ['https://api.nuget.org/v3-flatcontainer/%s/%s/' % (pkg, ver)],
    'extract_cmd': 'mkdir -p %(builddir)s/nuget && cp %s %(builddir)s/nuget/',
} for pkg, ver, _ in local_nuget_packages]
checksums += [{'%s.%s.nupkg' % (pkg, ver): sha256} for pkg, ver, sha256 in local_nuget_packages]

dependencies = [
    ('dotNET-Core', '6.0.420', '', SYSTEM),
    ('HTSlib', '1.23.1'),
]

# Keep SDK initialization and NuGet caches inside the build tree.
local_dotnet_env = 'DOTNET_CLI_HOME=%(builddir)s/dotnet-home DOTNET_CLI_TELEMETRY_OPTOUT=1 '
preconfigopts = local_dotnet_env
configure_cmd = 'dotnet restore Wittyer/Wittyer.csproj'
configure_without_installdir = True
configopts = '--source %(builddir)s/nuget --packages %(builddir)s/packages'

# Publishing compiles the application and installs all managed runtime dependencies.
skipsteps = ['build']
preinstallopts = local_dotnet_env
install_cmd = 'dotnet publish Wittyer/Wittyer.csproj --no-restore -c Release -p:UseAppHost=false'
installopts = '-o %(installdir)s/libexec/wittyer'

postinstallcmds = [
    'mkdir -p %(installdir)s/bin',
    """printf '#!/bin/sh\\nexec dotnet "%(installdir)s/libexec/wittyer/Wittyer.dll" "$@"\\n' """
    '> %(installdir)s/bin/wittyer',
    'chmod +x %(installdir)s/bin/wittyer',
]

sanity_check_paths = {
    'files': [
        'bin/wittyer',
        'libexec/wittyer/Wittyer.dll',
        'libexec/wittyer/Wittyer.deps.json',
        'libexec/wittyer/Wittyer.runtimeconfig.json',
        'libexec/wittyer/Ilmn.Das.App.Wittyer.dll',
        'libexec/wittyer/Config-default.json',
    ],
    'dirs': [],
}

sanity_check_commands = [
    "wittyer --version | grep 'witty.er %(version)s'",
    "wittyer --help | grep -- '--inputVcf'",
]

moduleclass = 'bio'
