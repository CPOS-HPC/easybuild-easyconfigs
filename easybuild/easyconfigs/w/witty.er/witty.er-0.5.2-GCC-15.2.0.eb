easyblock = 'ConfigureMake'

name = 'witty.er'
version = '0.5.2'

homepage = 'https://github.com/Illumina/witty.er'
description = """What is true, thank you, ernestly. A large variant benchmarking
 tool analogous to hap.py for small variants."""

# Match HTSlib's native utilities to the 2026.1 generation; the application itself uses .NET.
toolchain = {'name': 'GCC', 'version': '15.2.0'}

source_urls = ['https://github.com/Illumina/witty.er/archive/refs/tags/']
sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}]
checksums = [
    {'witty.er-0.5.2.tar.gz': '314451a59c7fc41076282b6ce2f1f4993363517c0812a8750f1595f46a80b487'},
]

# Complete NuGet package closure for the CLI and library projects, restored with .NET SDK 6.0.420.
# Keep the packages in a local feed so restore cannot download undeclared dependencies.
local_nuget_packages = [
    ('jetbrains.annotations', '11.1.0',
     '1c4c95c3e4c95a2fd8bb16e852983a3e3fc70489b8059b1807208c6a4835d3bf'),
