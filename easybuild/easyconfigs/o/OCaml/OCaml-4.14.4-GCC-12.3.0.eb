name = 'OCaml'
version = '4.14.4'

homepage = 'https://ocaml.org/'
description = """OCaml is a general-purpose programming language with an emphasis on expressiveness and safety."""

toolchain = {'name': 'GCC', 'version': '12.3.0'}

local_opam_ver = '2.1.5'
source_urls = [
    'https://github.com/ocaml/ocaml/archive',
    'https://github.com/ocaml/opam/releases/download/%s' % local_opam_ver,
]
sources = [
    '%s.tar.gz' % version,
    'opam-full-%s.tar.gz' % local_opam_ver,
]
checksums = [
    {'4.14.4.tar.gz': '71415c000ebfce604defafaa584ab5ed10ad81ff180897db4e6fea8dac6e4b0d'},
    {'opam-full-2.1.5.tar.gz': '09f8d9e410b2f5723c2bfedbf7970e3b305f5017895fcd91759f05e753ddcea5'},
]

builddependencies = [
    ('Autotools', '20220317'),
    ('pkgconf', '1.9.5'),
]

dependencies = [
    ('ncurses', '6.4'),
    ('libreadline', '8.2'),
    ('GSL', '2.7'),
]

preconfigopts = 'export CFLAGS="$CFLAGS -lm -lpthread" && '
preconfigopts += 'export AS=as && '

maxparallel = 1

# OPAM resolves and installs the transitive dependencies of these packages.
exts_list = [
    ('ocamlfind', '1.9.6'),
    ('ocamlbuild', '0.14.3'),
    ('batteries', '3.7.2'),
    ('conf-pkg-config', '3'),
    ('dune-configurator', '3.15.3'),
    ('dune', '3.15.3'),
    ('ocaml-twt', '0.94.0'),
    ('gsl', '1.24.3'),
]

# The gsl OCaml binding reads -I from pkg-config to locate GSL headers.
modextravars = {'PKG_CONFIG_ALLOW_SYSTEM_CFLAGS': '1'}

moduleclass = 'lang'
