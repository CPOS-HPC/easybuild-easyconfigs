Author: Emik Lin (HKUMed CPOS)
Retry creation of opam's repository archive when its source directory changes
while tar is reading it. This can happen during initialization on shared storage.
--- a/src/core/opamSystem.ml
+++ b/src/core/opamSystem.ml
@@ -923,11 +923,17 @@
 let make_tar_gz_job ~dir file =
   let tmpfile = file ^ ".tmp" in
-  remove_file tmpfile;
-  Tar.compress_command tmpfile dir @@> fun r ->
-  OpamProcess.cleanup r;
-  if OpamProcess.is_success r then
-    (mv tmpfile file; Done None)
-  else
-    (remove_file tmpfile; Done (Some (Process_error r)))
+  let rec attempt retries =
+    remove_file tmpfile;
+    Tar.compress_command tmpfile dir @@> fun r ->
+    OpamProcess.cleanup r;
+    if OpamProcess.is_success r then
+      (mv tmpfile file; Done None)
+    else if retries > 0 then (
+      log "Retrying repository archive creation after tar failed";
+      attempt (retries - 1)
+    ) else
+      (remove_file tmpfile; Done (Some (Process_error r)))
+  in
+  attempt 2
-
+
 let extract_job ~dir file =
