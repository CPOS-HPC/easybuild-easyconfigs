# Author: Emik Lin (HKUMed CPOS)
easyblock = 'ConfigureMake'

name = 'AnnotSV'
version = '3.5.10'

homepage = 'https://lbgi.fr/AnnotSV/'
description = "An integrated tool for structural variations annotation and ranking"

toolchain = {'name': 'foss', 'version': '2023b'}

source_urls = ['https://github.com/lgmgeo/AnnotSV/archive/refs/tags/']
sources = [{'download_filename': 'v%(version)s.tar.gz', 'filename': '%(name)s-%(version)s.tar.gz'}]
checksums = ['3cf870cf5a5f3b495b4f23eed8fee1e06ab9a6575b1324a20244db62c1e4a015']

builddependencies = [
    ('UnZip', '6.0'),
]

dependencies = [
    ('Tcl', '8.6.13'),
    ('BEDTools', '2.31.1'),
    ('BCFtools', '1.19'),
    ('Java', '17', '', SYSTEM),
    ('Python', '3.11.5'),
    ('variantconvert', '2.0.1'),
]

skipsteps = ['configure', 'build']
# Set PREFIX in Makefile to install to the correct directory and remove pip install related commands
preinstallopts = "sed -i 's|^PREFIX[[:space:]]*?=.*$|PREFIX ?= %(installdir)s|' Makefile && "
preinstallopts += "sed -i '/^[[:space:]]pip3 install /,+3d' Makefile && "
installopts = 'install-all-annotations'
postinstallcmds = [
    "cp -a %(start_dir)s/bin/INSTALL_annotations.sh %(installdir)s/bin/INSTALL_annotations.sh",
    "cp -a %(start_dir)s/Makefile %(installdir)s/Makefile",
    "chmod a+x %(installdir)s/bin/INSTALL_annotations.sh",
]

modextravars = {
    'ANNOTSV': '%(installdir)s',
}

sanity_check_paths = {
    'files': ['bin/%(name)s', 'bin/INSTALL_annotations.sh'],
    'dirs': [
        'share/AnnotSV/Annotations_Exomiser/2406',
        'share/AnnotSV/Annotations_Human',
        'share/AnnotSV/Annotations_Mouse',
    ],
}

sanity_check_commands = [
    '%(name)s -help',
]

moduleclass = 'bio'
