easyblock = 'PythonBundle'

name = 'pVACtools'
version = '7.1.1'

homepage = 'https://github.com/griffithlab/pVACtools'
description = """pVACtools is a cancer immunotherapy tools suite for identifying and prioritizing
neoantigens from sequencing data."""

