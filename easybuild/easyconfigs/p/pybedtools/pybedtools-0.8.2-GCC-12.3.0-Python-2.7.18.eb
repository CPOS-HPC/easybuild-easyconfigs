easyblock = 'PythonPackage'

name = 'pybedtools'
version = '0.8.2'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://daler.github.io/pybedtools'
description = "pybedtools wraps and extends BEDTools and offers feature-level manipulations from within Python."

toolchain = {'name': 'GCC', 'version': '12.3.0'}

sources = [SOURCE_TAR_GZ]
checksums = ['a184a36099458627e7ef52ea88218f7c00dc9c505b4256ece9ede58b1efa8771']

dependencies = [
    ('Python', '2.7.18'),
    ('BEDTools', '2.31.0'),
    ('Pysam', '0.20.0', versionsuffix),
]

moduleclass = 'bio'
