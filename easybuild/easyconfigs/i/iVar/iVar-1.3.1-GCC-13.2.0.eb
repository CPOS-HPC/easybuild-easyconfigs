easyblock = 'ConfigureMake'

name = 'iVar'
version = '1.3.1'

homepage = 'https://github.com/andersen-lab/ivar'
description = """
iVar is a computational package that contains functions broadly useful for viral amplicon-based sequencing.
"""

toolchain = {'name': 'GCC', 'version': '13.2.0'}

github_account = 'andersen-lab'
source_urls = [GITHUB_LOWER_SOURCE]
sources = ['v%(version)s.tar.gz']
patches = ['%(name)s-%(version)s-fix_gcc13.patch']
checksums = [
    'a5fb33e8e8fffedbb0836cb7c2f8b19d50f7f90112a9dca1f6a8e9f322056e6f', # v1.3.1.tar.gz
    '524fb4f99611ad5744a368533c121e64c7e29be0f39788f83eb3ba0cdfe03626', # iVar-1.3.1-fix_gcc13.patch
]

builddependencies = [('Autotools', '20220317')]
dependencies = [
    ('HTSlib', '1.19.1'),
]

preconfigopts = './autogen.sh &&'

sanity_check_paths = {
    'files': ['bin/ivar'],
    'dirs': [],
}

sanity_check_commands = ['ivar version']

moduleclass = 'bio'
