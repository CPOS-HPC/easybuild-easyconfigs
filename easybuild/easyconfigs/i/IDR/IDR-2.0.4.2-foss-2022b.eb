easyblock = 'PythonBundle'

name = 'IDR'
version = '2.0.4.2'

homepage = 'https://github.com/kundajelab/idr'
description = """
  The IDR (Irreproducible Discovery Rate) framework is a uniﬁed approach
  to measure the reproducibility of ﬁndings identiﬁed from replicate
  experiments and provide highly stable thresholds based on reproducibility.
"""

toolchain = {'name': 'foss', 'version': '2022b'}

dependencies = [
    ('Python', '3.10.8'),
    ('SciPy-bundle', '2023.02'),
    ('matplotlib', '3.7.0'),
]

exts_list = [
    (name, version, {
        'modulename': 'idr',
        'source_urls': ['https://github.com/kundajelab/idr/archive/'],
        'sources': [SOURCELOWER_TAR_GZ],
        'checksums': ['407f874fbe567ade139311fc005f9feddb0bd84366a54f6f5e2a100267fd6a31'],
    }),
]

# Fix for NumPy 1.24: change deprecated numpy.int to int
preinstallopts = "sed -i 's/numpy.int/int/g' idr/idr.py"

modextrapaths = {'PYTHONPATH': ['lib/python%(pyshortver)s/site-packages/%(namelower)s']}

sanity_check_paths = {
    'files': [],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = [
    "%(namelower)s --help",
    "%(namelower)s --version",
]

moduleclass = 'bio'
