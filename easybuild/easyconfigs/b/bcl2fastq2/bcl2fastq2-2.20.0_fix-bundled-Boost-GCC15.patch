Fix GCC 15 compatibility in the bundled Boost:
- add the missing filesys.h include needed to build Boost.Build;
- remove unnecessary parentheses from Boost.MPL pointer-to-member declarations;
- include <cstdint> so Boost.Atomic can declare atomic<uintptr_t>.
Author: Emik Lin (HKUMed CPOS)
--- a/src/cmake/bootstrap/installBoost.sh
+++ b/src/cmake/bootstrap/installBoost.sh
@@ -47,5 +47,16 @@
-cd ${SOURCE_DIR} \
-    && ./bootstrap.sh ${BOOTSTRAP_OPTIONS} --prefix=${INSTALL_DIR} --with-libraries=`echo ${BCL2FASTQ_BOOST_COMPONENTS} | sed "s/;/,/g"` \
-    && echo "using gcc : : ${CXX} ;" >${SOURCE_DIR}/tools/build/v2/user-config.jam \
-    && echo "modules.poke : NO_BZIP2 : 1 ;" >>${SOURCE_DIR}/tools/build/v2/user-config.jam \
-    && ./bjam -j$PARALLEL ${BJAM_OPTIONS} --libdir=${INSTALL_DIR}/lib --layout=system link=static threading=multi install
+cd "${SOURCE_DIR}" && {
+    patch -p0 -N --batch <<'EOF'
+--- tools/build/v2/engine/modules/path.c
++++ tools/build/v2/engine/modules/path.c
+@@ -11,2 +11,3 @@
+ #include "../timestamp.h"
++#include "../filesys.h"
+EOF
+
+    sed -i -e '187s/(Pred::/Pred::/;189s/);/;/;192s/(boost::/boost::/;194s/);/;/' boost/mpl/assert.hpp &&
+    { grep -q '^#include <cstdint>$' boost/atomic/atomic.hpp || sed -i '12i#include <cstdint>' boost/atomic/atomic.hpp; } &&
+    ./bootstrap.sh ${BOOTSTRAP_OPTIONS} --prefix="${INSTALL_DIR}" --with-libraries="$(echo "${BCL2FASTQ_BOOST_COMPONENTS}" | sed 's/;/,/g')" &&
+    echo "using gcc : : ${CXX} ;" > "${SOURCE_DIR}/tools/build/v2/user-config.jam" &&
+    echo "modules.poke : NO_BZIP2 : 1 ;" >> "${SOURCE_DIR}/tools/build/v2/user-config.jam" &&
+    ./bjam -j"$PARALLEL" ${BJAM_OPTIONS} --libdir="${INSTALL_DIR}/lib" --layout=system link=static threading=multi install
+}
