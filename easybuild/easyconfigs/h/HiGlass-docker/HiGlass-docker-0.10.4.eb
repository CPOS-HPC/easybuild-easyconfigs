easyblock = 'Apptainer'

name = 'HiGlass-docker'
version = '0.10.4'

homepage = 'https://github.com/higlass/higlass-docker'
description = "HiGlass Docker wraps higlass-client and higlass-server in an nginx web server."

toolchain = SYSTEM

# Parameters passed to the build_container_image.sh script
apptainer_type = 'sif'

local_image_digest = 'sha256:44086069ee7d4d3f6f3f0012569789ec138f42b84aa44357826c0b6753eb28de'
installopts = '-s higlass/higlass-docker@%s ' % local_image_digest
installopts += '-i image '

# Install configuration templates used by the launcher to run the Docker image as an unprivileged Apptainer process.
postinstallcmds = [
    'mkdir -p %(installdir)s/bin %(installdir)s/etc',
    'apptainer exec %(installdir)s/%(namelower)s-%(version)s.sif '
    'cat /etc/nginx/sites-enabled/hgserver_nginx.conf > %(installdir)s/etc/hgserver_nginx.conf.in',
    'apptainer exec %(installdir)s/%(namelower)s-%(version)s.sif '
    'cat /etc/nginx/nginx.conf > %(installdir)s/etc/nginx.conf.in',
    'apptainer exec %(installdir)s/%(namelower)s-%(version)s.sif '
    'cat /home/higlass/projects/higlass-app/index.html > %(installdir)s/etc/index.html.in',
    'apptainer exec %(installdir)s/%(namelower)s-%(version)s.sif '
    'cat /home/higlass/projects/higlass-app/config.js > %(installdir)s/etc/config.js.in',
    """cat > %(installdir)s/bin/higlass-docker << 'HIGLASS_WRAPPER'
#!/bin/bash
set -euo pipefail

port="${HIGLASS_PORT:-8888}"
base_url="${HIGLASS_BASE_URL:-}"
data_dir="${HIGLASS_DATA_DIR:-$HOME/hg-data}"
tmp_dir="${HIGLASS_TMP_DIR:-$HOME/hg-tmp}"
workers="${HIGLASS_WORKERS:-4}"
uwsgi_section='[program:uwsgi]'
nginx_section='[program:nginx]'
supervisord_section='[supervisord]'

if [[ ! "$port" =~ ^[0-9]+$ ]] || ((port < 1024 || port > 65535)); then
    echo "ERROR: HIGLASS_PORT must be an integer from 1024 through 65535." >&2
    exit 2
fi
if [[ ! "$workers" =~ ^[0-9]+$ ]] || ((workers < 1)); then
    echo "ERROR: HIGLASS_WORKERS must be a positive integer." >&2
    exit 2
fi
if [[ -n "$base_url" ]]; then
    base_url="/${base_url#/}"
    base_url="${base_url%/}"
    if [[ ! "$base_url" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
        echo "ERROR: HIGLASS_BASE_URL contains unsupported characters." >&2
        exit 2
    fi
fi

mkdir -p "$data_dir/log" "$tmp_dir"
runtime_dir="$(mktemp -d "${TMPDIR:-/tmp}/higlass-docker.XXXXXX")"
socket_name="higlass-$$.sock"

sed \
    -e "s|server 127.0.0.1:8001;|server unix:/tmp/${socket_name};|" \
    -e "s|listen      80;|listen      ${port};|" \
    -e '/include .*uwsgi_params;/a\\
        uwsgi_param HTTP_X_FORWARDED_HOST $higlass_forwarded_host;' \
    %(installdir)s/etc/hgserver_nginx.conf.in > "$runtime_dir/hgserver_nginx.conf"

sed \
    -e 's|worker_processes auto;|worker_processes 1;|' \
    -e "s|pid /run/nginx.pid;|pid /tmp/nginx-$$.pid;|" \
    -e '/^http {/a\\
    map $http_x_forwarded_host $higlass_forwarded_host {\\
        ~^[[:space:]]*(?<first_forwarded_host>[^,[:space:]]+) $first_forwarded_host;\\
        default $host;\\
    }\\
    client_body_temp_path /tmp/nginx-client-body;\\
    proxy_temp_path /tmp/nginx-proxy;\\
    fastcgi_temp_path /tmp/nginx-fastcgi;\\
    uwsgi_temp_path /tmp/nginx-uwsgi;\\
    scgi_temp_path /tmp/nginx-scgi;' \
    %(installdir)s/etc/nginx.conf.in > "$runtime_dir/nginx.conf"

if [[ -n "$base_url" ]]; then
    sed \
        -e "s|href=\\\"/|href=\\\"${base_url}/|g" \
        -e "s|src=\\\"/|src=\\\"${base_url}/|g" \
        -e "s|l\\.p=\\\"/\\\"|l.p=\\\"${base_url}/\\\"|g" \
        %(installdir)s/etc/index.html.in > "$runtime_dir/index.html"
    sed \
        -e "s|window.HGAC_SERVER=\\\"\\\";|window.HGAC_SERVER=\\\"${base_url}\\\";|" \
        %(installdir)s/etc/config.js.in > "$runtime_dir/config.js"
    echo "window.HGAC_BASEPATH=\\\"${base_url}\\\";" >> "$runtime_dir/config.js"
else
    cp %(installdir)s/etc/index.html.in "$runtime_dir/index.html"
    cp %(installdir)s/etc/config.js.in "$runtime_dir/config.js"
fi

cat > "$runtime_dir/supervisord.conf" <<SUPERVISOR_EOF
${uwsgi_section}
directory=/home/higlass/projects/higlass-server
command=bash -c "mkdir -p /data/log && python manage.py migrate && \
(python manage.py loaddata default-viewconf-fixture.xml || true); \
exec uwsgi --chdir /home/higlass/projects/higlass-server \
--module higlass_server.wsgi --socket /tmp/${socket_name} --chmod-socket=666 \
--master --workers ${workers}"

${nginx_section}
command=/usr/sbin/nginx

${supervisord_section}
nodaemon=true
logfile=/tmp/supervisord-$$.log
pidfile=/tmp/supervisord-$$.pid
childlogdir=/tmp
SUPERVISOR_EOF

exec apptainer exec \\
    --writable-tmpfs \\
    --cwd /home/higlass/projects \\
    --bind "$data_dir":/data \\
    --bind "$tmp_dir":/tmp \\
    --bind "$runtime_dir/nginx.conf":/etc/nginx/nginx.conf \\
    --bind "$runtime_dir/hgserver_nginx.conf":/etc/nginx/sites-enabled/hgserver_nginx.conf \\
    --bind "$runtime_dir/index.html":/home/higlass/projects/higlass-app/index.html \\
    --bind "$runtime_dir/config.js":/home/higlass/projects/higlass-app/config.js \\
    --bind "$runtime_dir/supervisord.conf":/home/higlass/projects/supervisord-ood.conf \\
    %(installdir)s/%(namelower)s-%(version)s.sif \\
    supervisord -n -c /home/higlass/projects/supervisord-ood.conf "$@"
HIGLASS_WRAPPER""",
    'chmod +x %(installdir)s/bin/higlass-docker',
]

sanity_check_paths = {
    'files': [
        '%(namelower)s-%(version)s.sif',
        'bin/higlass-docker',
        'etc/config.js.in',
        'etc/hgserver_nginx.conf.in',
        'etc/index.html.in',
        'etc/nginx.conf.in',
    ],
    'dirs': ['bin', 'etc'],
}

sanity_check_commands = [
    'apptainer inspect %(installdir)s/%(namelower)s-%(version)s.sif',
    'bash -n %(installdir)s/bin/higlass-docker',
    "grep -q 'window.HGAC_SERVER' %(installdir)s/etc/config.js.in",
    "grep -q 'server 127.0.0.1:8001;' %(installdir)s/etc/hgserver_nginx.conf.in",
    "grep -q 'map .http_x_forwarded_host .higlass_forwarded_host' %(installdir)s/bin/higlass-docker",
    "grep -q 'HTTP_X_FORWARDED_HOST .higlass_forwarded_host' %(installdir)s/bin/higlass-docker",
    'apptainer exec %(installdir)s/%(namelower)s-%(version)s.sif sh -c '
    '"grep -q HGAC_BASEPATH /home/higlass/projects/higlass-app/static/js/main.*.chunk.js"',
]

modextravars = {
    'HIGLASS_DOCKER_SIF': '%(installdir)s/%(namelower)s-%(version)s.sif',
}

modloadmsg = "%(name)s %(version)s is provided via an Apptainer container.\n\n"
modloadmsg += 'Start HiGlass at http://localhost:8888 with:\n    higlass-docker\n\n'
modloadmsg += 'For Open OnDemand, set HIGLASS_PORT and HIGLASS_BASE_URL to the assigned connection values.\n'
modloadmsg += 'Optional settings: HIGLASS_DATA_DIR, HIGLASS_TMP_DIR, and HIGLASS_WORKERS.\n'

moduleclass = 'bio'
