easyblock = 'CMakeMake'

name = 'hap.py'
version = '0.3.15'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://github.com/Illumina/hap.py'
description = """ Haplotype VCF comparison tools"""

toolchain = {'name': 'foss', 'version': '2023a'}

source_urls = ['https://github.com/Illumina/hap.py/archive/']
sources = ['v%(version)s.tar.gz']
patches = ['hap.py-0.3.15_fix-limits.patch']
checksums = [
    '838912f1ab805224110af3c1035849d5483b5ce4c565ae0f0db7f7284af06676', # v0.3.15.tar.gz
    '4712479d6ecfb5c51b2aaac2f956290dd6cc43554d53ba4e1b8f2a45e5b76d8b', # hap.py-0.3.15_fix-limits.patch
]

builddependencies = [
    ('binutils', '2.40'),
    ('CMake', '3.26.3'),
]

dependencies = [
    ('Boost', '1.82.0'),
    ('Python', '2.7.18'),
    ('SciPy-bundle', '2024.06', versionsuffix),
    ('Pysam', '0.20.0', versionsuffix),
    ('bx-python', '0.8.9', versionsuffix),
    ('Java', '8', '', SYSTEM),
]

modextrapaths = {'PYTHONPATH': ''}

sanity_check_paths = {
    'files': ['bin/hap.py'],
    'dirs': ['bin'],
}

sanity_check_commands = ["python bin/hap.py --version | grep %(version)s"]

moduleclass = 'math'
