easyblock = 'PythonBundle'

name = 'ESM3'
version = '3.4.3'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://github.com/Biohub/esm'
description = """ESM3 is a generative model for protein design that jointly reasons across protein sequence,
structure, and function. This module provides Biohub's esm Python package, which also includes ESMC and ESMFold2."""

toolchain = {'name': 'foss', 'version': '2025b'}

dependencies = [
    ('CUDA', '12.9.1', '', SYSTEM),
    ('Python', '3.13.5'),
    ('PyTorch', '2.13.0', versionsuffix + '-whl'),
    ('Transformers', '5.16.0'),
    ('Biopython', '1.86'),
